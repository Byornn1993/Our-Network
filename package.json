{
  "name": "our-network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Our Network — onze mensen, onze momenten, ons verhaal. Persoonlijke PWA van Bjorn & Stephanie.",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode devlocal",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/artifact-page.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:setup-sql": "node scripts/gen-setup-sql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@supabase/supabase-js": "^2.50.0",
    "date-fns": "4.1.0",
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6",
    "uuid": "^11.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.13",
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@types/node": "22.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "fake-indexeddb": "6.0.0",
    "globals": "15.12.0",
    "postcss": "^8.5.33",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "0.21.0",
    "vitest": "^2.1.9",
    "workbox-window": "7.3.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  }
}
